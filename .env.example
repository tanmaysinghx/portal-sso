# Copy to .env and fill in. Every value below is required — compose refuses to start rather than
# fall back to a default, because a self-hosted identity server with guessable credentials is worse
# than one that will not boot.
#
# .env is gitignored. Do not commit it.

# --- Database -------------------------------------------------------------------------------
DB_NAME=portalsso
DB_USERNAME=portal
# Generate one:  openssl rand -base64 24
DB_PASSWORD=

# --- Public address -------------------------------------------------------------------------
# How browsers and relying applications reach this server. Published in the OIDC discovery
# document and validated by every client, so it must match exactly — including scheme and port.
# Behind a reverse proxy this is the public https:// address.
ISSUER_URL=http://localhost:8080
SERVER_PORT=8080

# Set to FRAMEWORK when running behind a reverse proxy or load balancer, so client IPs in the
# audit log, login events and rate-limit buckets are the real caller rather than the proxy.
# Leave unset when the app is directly exposed — trusting X-Forwarded-* otherwise lets any caller
# forge their source address.
# FORWARD_HEADERS_STRATEGY=FRAMEWORK

# --- MFA ------------------------------------------------------------------------------------
# Encrypts stored TOTP secrets. Without it, MFA enrolment is refused; with secrets already stored
# and this unset, the server refuses to start.
#
# BACK THIS UP. Losing it means every enrolled user has to re-enrol.
# Generate one:  openssl rand -base64 32
APP_SECURITY_MFA_ENCRYPTION_KEY=

# --- First administrator --------------------------------------------------------------------
# Created on first boot only, when no enabled administrator exists. Remove both lines once you
# have signed in — while they are set, anyone who can read this file knows the password.
# Minimum 12 characters, and it must satisfy the password policy (10+, upper, lower, digit).
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Local trial only -----------------------------------------------------------------------
# Session cookies are Secure by default, so a browser will not send them over plain http. Set this
# to false ONLY for a local trial without TLS. Never in a deployment anyone else can reach.
# SERVER_SERVLET_SESSION_COOKIE_SECURE=false
