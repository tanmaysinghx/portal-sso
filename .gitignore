# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — never commit
# Repo-wide net. Sub-project .gitignore files repeat some of these on purpose:
# if one of those is ever deleted, this file still catches the credential.
# ─────────────────────────────────────────────────────────────────────────────

# Spring Boot runtime config. ./config/ is loaded at runtime and is NOT packaged
# into the jar, which is exactly why real credentials live there.
**/config/application-local.yml
**/application-local.yml
**/application-secret*.yml
**/application-prod*.yml
**/application-staging*.yml

# Environment files
.env
.env.*
*.env

# Key material — signing keys, TLS certs, keystores. The JWK-persistence work
# may start writing these; ignore them before that happens, not after.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
id_rsa*
secrets/
credentials.json
service-account*.json

# Templates and samples must stay committed — this must be the LAST rule in
# this section so it wins over the patterns above.
!**/*.example
!**/*.sample
!**/*.template

# ─────────────────────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────────────────────

# Java / Maven
target/
build/
!**/src/**/target/
!**/src/**/build/
*.class
*.jar
*.war
!**/.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml

# Node / Angular
node_modules/
dist/
.angular/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
# Editors and OS
# ─────────────────────────────────────────────────────────────────────────────

.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/
*.swp
*~

# Keep shared VS Code project settings, drop personal state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────────────────────
# Logs and scratch
# ─────────────────────────────────────────────────────────────────────────────

*.log
logs/
tmp/
.cache/
*.pid
